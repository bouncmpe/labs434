<mujoco model="force_torque_sensor">
  <statistic center="0 0 0.1" extent="0.6" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.1"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="post" type="cylinder" pos="0 0 0.25" size="0.03 0.25" rgba="0.5 0.5 0.5 1"/>

    <body name="arm" pos="0 0 0.5">
      <joint name="shoulder" type="hinge" axis="0 1 0" range="-90 90" solreflimit="0.004 1"/>
      <geom name="axle" type="cylinder" fromto="0 -0.04 0 0 0.04 0" size="0.02" rgba="0.2 0.2 0.2 1"/>
      <geom name="link" type="capsule" fromto="0 0 0 0.3 0 0" size="0.02" rgba="0 0.6 0.9 1" mass="0.5"/>

      <!-- The payload is welded to the arm (no joint). Force and torque sensors report the interaction
           wrench between the site's body and its parent, expressed in the site frame. -->
      <body name="payload" pos="0.3 0 0">
        <geom name="flange" type="cylinder" fromto="0 0 0 0.01 0 0" size="0.03" rgba="0.2 0.2 0.2 1" mass="0.05"/>
        <geom name="weight" type="box" pos="0.06 0 0" size="0.05 0.03 0.03" rgba="0.9 0.6 0 1" mass="1"/>
        <site name="wrist" size="0.015" rgba="1 0.3 0 1"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <force name="wrist_force" site="wrist"/>
    <torque name="wrist_torque" site="wrist"/>
    <jointpos name="shoulder_pos" joint="shoulder"/>
    <actuatorfrc name="shoulder_torque" actuator="position_servo"/>
  </sensor>

  <actuator>
    <position name="position_servo" joint="shoulder" kp="50" kv="5" ctrlrange="-1.57 1.57"/>
  </actuator>
</mujoco>
