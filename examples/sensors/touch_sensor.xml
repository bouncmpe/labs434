<mujoco model="touch_sensor">
  <statistic center="0 0 0.1" extent="0.6" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- A spring-loaded weighing platform. The touch sensor sums the normal forces of all contacts
         on the platform body whose contact points fall inside the site volume. -->
    <geom name="base" type="box" pos="0 0 0.02" size="0.16 0.16 0.02" rgba="0.5 0.5 0.5 1"/>
    <body name="platform" pos="0 0 0.1">
      <joint name="spring" type="slide" axis="0 0 1" stiffness="2000" damping="20" range="-0.05 0.05"/>
      <geom name="plate" type="box" size="0.15 0.15 0.01" rgba="0 0.6 0.9 1" mass="0.5"/>
      <site name="touch_area" type="box" pos="0 0 0.01" size="0.15 0.15 0.01" rgba="1 0.3 0 0.3"/>
    </body>

    <!-- Objects that fall on the platform: 1 kg + 0.5 kg, i.e. about 14.7 N at rest. -->
    <body name="cube" pos="0.05 0.02 0.4" euler="10 20 30">
      <freejoint/>
      <geom name="cube" type="box" size="0.04 0.04 0.04" rgba="0.9 0.6 0 1" mass="1"/>
    </body>
    <body name="ball" pos="-0.06 -0.04 0.7">
      <freejoint/>
      <geom name="ball" type="sphere" size="0.04" rgba="0.2 0.8 0.3 1" mass="0.5"/>
    </body>
  </worldbody>

  <sensor>
    <touch name="touch" site="touch_area"/>
    <jointpos name="spring_pos" joint="spring"/>
  </sensor>
</mujoco>
