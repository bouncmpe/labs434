<mujoco model="spherical_joint_position">
  <statistic center="0 0 0.1" extent="0.6" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.01" armature="0.005"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="post" type="cylinder" fromto="0 0 0 0 0 0.46" size="0.02" rgba="0.5 0.5 0.5 1"/>
    <geom name="socket" type="cylinder" fromto="0 0 0.46 0 0 0.49" size="0.04" rgba="0.5 0.5 0.5 1"/>

    <body name="link" pos="0 0 0.5">
      <joint name="ball" type="ball" range="0 60" solreflimit="0.004 1"/>
      <geom name="ball" type="sphere" size="0.03" rgba="0.9 0.6 0 1" mass="0.05"/>
      <geom name="rod" type="capsule" fromto="0 0 0.03 0 0 0.35" size="0.012" rgba="0 0.6 0.9 1" mass="0.2"/>
      <geom name="flag" type="box" pos="0 0 0.3" size="0.06 0.004 0.03" rgba="1 0.3 0 1" mass="0.02"/>
      <site name="tip" pos="0 0 0.35" size="0.012" rgba="1 0.3 0 1"/>
    </body>
  </worldbody>

  <sensor>
    <ballquat name="ball_quat" joint="ball"/>
    <ballangvel name="ball_angvel" joint="ball"/>
    <framepos name="tip_pos" objtype="site" objname="tip"/>
  </sensor>

  <actuator>
    <position name="position_servo_x" joint="ball" gear="1 0 0" kp="5" kv="0.5" ctrlrange="-1.05 1.05"/>
    <position name="position_servo_y" joint="ball" gear="0 1 0" kp="5" kv="0.5" ctrlrange="-1.05 1.05"/>
    <position name="position_servo_z" joint="ball" gear="0 0 1" kp="5" kv="0.5" ctrlrange="-1.05 1.05"/>
  </actuator>
</mujoco>
