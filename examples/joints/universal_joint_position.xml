<mujoco model="universal_joint_2dof_position">
  <statistic center="0 0 0.1" extent="0.6" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.01"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="post" type="cylinder" fromto="0 0 0 0 0 0.43" size="0.02" rgba="0.5 0.5 0.5 1"/>
    <geom name="base_yoke_base" type="box" pos="0 0 0.435" size="0.012 0.055 0.005" rgba="0.5 0.5 0.5 1"/>
    <geom name="base_yoke_arm1" type="box" pos="0 0.05 0.47" size="0.012 0.005 0.035" rgba="0.5 0.5 0.5 1"/>
    <geom name="base_yoke_arm2" type="box" pos="0 -0.05 0.47" size="0.012 0.005 0.035" rgba="0.5 0.5 0.5 1"/>

    <body name="cross" pos="0 0 0.5">
      <joint name="cross_y" type="hinge" axis="0 1 0" range="-60 60" solreflimit="0.004 1"/>
      <geom name="cross_arm_y" type="cylinder" fromto="0 -0.045 0 0 0.045 0" size="0.008" rgba="0.9 0.6 0 1" mass="0.02"/>
      <geom name="cross_arm_x" type="cylinder" fromto="-0.045 0 0 0.045 0 0" size="0.008" rgba="0.9 0.6 0 1" mass="0.02"/>

      <body name="link">
        <joint name="cross_x" type="hinge" axis="1 0 0" range="-60 60" solreflimit="0.004 1"/>
        <geom name="link_yoke_base" type="box" pos="0 0 0.065" size="0.055 0.012 0.005" rgba="0 0.6 0.9 1" mass="0.02"/>
        <geom name="link_yoke_arm1" type="box" pos="0.05 0 0.03" size="0.005 0.012 0.035" rgba="0 0.6 0.9 1" mass="0.02"/>
        <geom name="link_yoke_arm2" type="box" pos="-0.05 0 0.03" size="0.005 0.012 0.035" rgba="0 0.6 0.9 1" mass="0.02"/>
        <geom name="link_rod" type="capsule" fromto="0 0 0.07 0 0 0.35" size="0.012" rgba="0 0.6 0.9 1" mass="0.2"/>
        <site name="tip" pos="0 0 0.35" size="0.012" rgba="1 0.3 0 1"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <jointpos name="cross_y_pos" joint="cross_y"/>
    <jointpos name="cross_x_pos" joint="cross_x"/>
    <jointvel name="cross_y_vel" joint="cross_y"/>
    <jointvel name="cross_x_vel" joint="cross_x"/>
    <framepos name="tip_pos" objtype="site" objname="tip"/>
  </sensor>

  <actuator>
    <position name="position_servo_y" joint="cross_y" kp="5" kv="0.5" ctrlrange="-1.05 1.05"/>
    <position name="position_servo_x" joint="cross_x" kp="5" kv="0.5" ctrlrange="-1.05 1.05"/>
  </actuator>
</mujoco>
